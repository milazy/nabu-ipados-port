diff --git a/bsd/dev/nabu_pmem.c b/bsd/dev/nabu_pmem.c
new file mode 100644
index 0000000..e74758b
--- /dev/null
+++ b/bsd/dev/nabu_pmem.c
@@ -0,0 +1,386 @@
+/*
+ * /dev/pmem: physical memory for userland hardware experiments (the GPU
+ * bring-up in work/userland/gpu runs on it over SSH, no reboot per try).
+ * Root only (0600). nabu: off unless boot-arg nabu-pmem=1 (port of sd855_ios26 bsd/dev/sweet_pmem.c,
+ * patches 0094/0095/0102, for the userland WCN3998 bring-up wland).
+ *
+ *   pread/pwrite at offset = physical address.
+ *     Managed DRAM goes through the physical aperture with the lines
+ *     cleaned+invalidated to the point of coherency before and after, so
+ *     data a device wrote is seen and CPU writes reach memory (IO is not
+ *     coherent here). Anything else (MMIO, carve-outs such as the panel
+ *     framebuffer) is mapped as device memory and accessed with 32-bit
+ *     loads/stores only: offset and length must be multiples of 4.
+ *     Reading an unclocked block hangs the SoC, as with poke scripts.
+ *   ioctl PMEM_ALLOC   {size, align} -> {pa}: zeroed, physically contiguous
+ *                      kernel memory (stays until PMEM_FREE, survives exit)
+ *   ioctl PMEM_FREE    {pa}
+ *   ioctl PMEM_SMC     x0..x7 in, x0..x3 out (SMCCC; e.g. SCM PAS calls)
+ *   ioctl PMEM_LIST    allocation table, for tools that lost their state
+ *   ioctl PMEM_RPMH    one RPMh active vote: resource name, 1-4 (offset, value) commands
+ *                      (ARC levels, VRM rails; bsd/dev/sweet_rpmh.c)
+ *
+ * Userland side: work/userland/gpu/pmem.h (same structs and numbers).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+void nabu_pmem_init(void);
+void nabu_smc(uint64_t x[8]);
+
+struct pmem_alloc {
+	uint64_t size;          /* in: bytes (rounded up to pages) */
+	uint64_t align;         /* in: bytes, power of 2, 0 = page */
+	uint64_t pa;            /* out */
+};
+struct pmem_smc {
+	uint64_t x[8];
+};
+#define PMEM_LIST_MAX   64
+struct pmem_list {
+	uint32_t count;
+	uint32_t pad;
+	struct {
+		uint64_t pa, size;
+	} ent[PMEM_LIST_MAX];
+};
+#define PMEM_ALLOC      _IOWR('P', 1, struct pmem_alloc)
+#define PMEM_FREE       _IOW('P', 2, uint64_t)
+#define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
+#define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+struct pmem_log {
+	char text[240];
+};
+#define PMEM_LOG        _IOW('P', 6, struct pmem_log)
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name, e.g. "mss.lvl", "ldoa1" */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int nabu_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+#define PMEM_MAPS       16              /* 2 MB device windows, round robin */
+#define PMEM_WIN        0x200000ULL
+
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} pm_alloc[PMEM_LIST_MAX];
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} pm_map[PMEM_MAPS];
+static unsigned pm_map_next;
+static uint32_t pm_bounce[PAGE_SIZE / 4];
+
+static LCK_GRP_DECLARE(nabu_pmem_grp, "nabu_pmem");
+static LCK_MTX_DECLARE(nabu_pmem_lock, &nabu_pmem_grp);
+
+/*
+ * Device mapping of the 2 MB window holding pa, from a small round-robin
+ * cache. ml_io_map's mappings are permanent (unmapping one panics) and come
+ * from the small io_submap (a 2 MB one panicked "kmem_alloc failed"), so
+ * windows use ml_io_map_unmappable: kernel_map, freed by ml_io_unmap.
+ */
+static volatile uint32_t *
+pm_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(PMEM_WIN - 1);
+	for (unsigned i = 0; i < PMEM_MAPS; i++) {
+		if (pm_map[i].va && pm_map[i].win == win) {
+			return (volatile uint32_t *)(pm_map[i].va + (pa - win));
+		}
+	}
+	unsigned i = pm_map_next++ % PMEM_MAPS;
+	if (pm_map[i].va) {
+		ml_io_unmap(pm_map[i].va, PMEM_WIN);
+	}
+	pm_map[i].va = ml_io_map_unmappable((vm_offset_t)win, PMEM_WIN, VM_WIMG_IO);
+	pm_map[i].win = win;
+	return pm_map[i].va ? (volatile uint32_t *)(pm_map[i].va + (pa - win)) : NULL;
+}
+
+static int
+pm_rw(struct uio *uio, bool write)
+{
+	int err = 0;
+	lck_mtx_lock(&nabu_pmem_lock);
+	while (!err && uio_resid(uio) > 0) {
+		uint64_t pa = (uint64_t)uio_offset(uio);
+		uint64_t off = pa & PAGE_MASK;
+		unsigned n = (unsigned)MIN((user_ssize_t)(PAGE_SIZE - off), uio_resid(uio));
+		if (pmap_valid_address(pa)) {
+			caddr_t va = (caddr_t)phystokv(pa);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			err = uiomove(va, (int)n, uio);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			continue;
+		}
+		if ((pa | n) & 3) {
+			err = EINVAL;
+			break;
+		}
+		volatile uint32_t *r = pm_io(pa);
+		if (r == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		if (write) {
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			for (unsigned i = 0; !err && i < n / 4; i++) {
+				r[i] = pm_bounce[i];
+			}
+			__asm__ volatile ("dsb osh" ::: "memory");
+		} else {
+			for (unsigned i = 0; i < n / 4; i++) {
+				pm_bounce[i] = r[i];
+			}
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+		}
+	}
+	lck_mtx_unlock(&nabu_pmem_lock);
+	return err;
+}
+
+static int
+pm_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, false);
+}
+
+static int
+pm_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, true);
+}
+
+static int
+pm_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+pm_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+pm_smc_once(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x[0] = x0;
+	x[1] = x1;
+	x[2] = x2;
+	x[3] = x3;
+	x[6] = x6;
+}
+
+/*
+ * Qualcomm TZ returns QCOM_SCM_INTERRUPTED (1) when a non-secure interrupt
+ * arrives during a call (the shim never saw it: interrupts off). Like
+ * Linux's __scm_smc_do_quirk: call again with x0 = 1, the same arguments
+ * and the x6 TZ handed back (ARM_SMCCC_QUIRK_QCOM_A6), on the same CPU,
+ * until a final result.
+ */
+#define QCOM_SCM_INTERRUPTED    1
+
+static void
+pm_smc(struct pmem_smc *s)
+{
+	uint64_t x[8], fn = s->x[0];
+	unsigned resumes = 0;
+	memcpy(x, s->x, sizeof(x));
+	_disable_preemption();
+	for (;;) {
+		pm_smc_once(x);
+		if (x[0] != QCOM_SCM_INTERRUPTED || resumes >= 100000) {
+			break;
+		}
+		uint64_t a6 = x[6];
+		memcpy(x, s->x, sizeof(x));
+		x[0] = QCOM_SCM_INTERRUPTED;
+		x[6] = a6;
+		resumes++;
+	}
+	_enable_preemption();
+	memcpy(s->x, x, 4 * sizeof(uint64_t));
+	if (resumes) {
+		printf("NABU PMEM: smc %llx resumed %u times -> %llx\n", fn, resumes, x[0]);
+	}
+}
+
+/* For bsd/dev/sweet_gpu.c (zap shader): x0..x7 in, x0..x3 out. */
+void
+nabu_smc(uint64_t x[8])
+{
+	struct pmem_smc s;
+	memcpy(s.x, x, sizeof(s.x));
+	pm_smc(&s);
+	memcpy(x, s.x, 4 * sizeof(uint64_t));
+}
+
+static int
+pm_do_alloc(struct pmem_alloc *a)
+{
+	vm_size_t size = round_page(a->size);
+	uint64_t align = a->align > PAGE_SIZE ? a->align : PAGE_SIZE;
+	if (size == 0 || (align & (align - 1))) {
+		return EINVAL;
+	}
+	int slot = -1;
+	for (int i = 0; i < PMEM_LIST_MAX; i++) {
+		if (!pm_alloc[i].va) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		return ENOSPC;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, size, PAGE_MASK, 0, (ppnum_t)(atop_64(align) - 1),
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (!pn) {
+		kmem_free(kernel_map, va, size);
+		return ENOMEM;
+	}
+	a->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)a->pa, (unsigned)size, TRUE);
+	pm_alloc[slot].va = va;
+	pm_alloc[slot].pa = a->pa;
+	pm_alloc[slot].size = size;
+	printf("NABU PMEM: alloc %llu bytes at 0x%llx (pid %d)\n", (uint64_t)size, a->pa, proc_selfpid());
+	return 0;
+}
+
+static int
+pm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int err = 0;
+	lck_mtx_lock(&nabu_pmem_lock);
+	switch (cmd) {
+	case PMEM_ALLOC:
+		err = pm_do_alloc((struct pmem_alloc *)data);
+		break;
+	case PMEM_FREE: {
+		uint64_t pa = *(uint64_t *)data;
+		err = ENOENT;
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va && pm_alloc[i].pa == pa) {
+				kmem_free(kernel_map, pm_alloc[i].va, (vm_size_t)pm_alloc[i].size);
+				pm_alloc[i].va = 0;
+				err = 0;
+				break;
+			}
+		}
+		break;
+	}
+	case PMEM_SMC:
+		pm_smc((struct pmem_smc *)data);
+		break;
+	case PMEM_LIST: {
+		struct pmem_list *l = (struct pmem_list *)data;
+		bzero(l, sizeof(*l));
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va) {
+				l->ent[l->count].pa = pm_alloc[i].pa;
+				l->ent[l->count].size = pm_alloc[i].size;
+				l->count++;
+			}
+		}
+		break;
+	}
+	case PMEM_RPMH: {
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		lck_mtx_unlock(&nabu_pmem_lock);       /* waits up to 100 ms; not under our lock */
+		err = nabu_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("NABU PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
+	case PMEM_LOG: {
+		struct pmem_log *l = (struct pmem_log *)data;
+		l->text[sizeof(l->text) - 1] = 0;
+		printf("NABU WLAND: %s\n", l->text);
+		break;
+	}
+	default:
+		err = ENOTTY;
+	}
+	lck_mtx_unlock(&nabu_pmem_lock);
+	return err;
+}
+
+static const struct cdevsw nabu_pmem_cdevsw = {
+	.d_open       = pm_open,
+	.d_close      = pm_close,
+	.d_read       = pm_read,
+	.d_write      = pm_write,
+	.d_ioctl      = pm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+nabu_pmem_init(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("nabu-pmem", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &nabu_pmem_cdevsw);
+	if (major < 0) {
+		printf("NABU PMEM: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "pmem");
+	printf("NABU PMEM: /dev/pmem ready (major %d)\n", major);
+}
diff --git a/bsd/dev/nabu_rpmh.c b/bsd/dev/nabu_rpmh.c
new file mode 100644
index 0000000..3a961f1
--- /dev/null
+++ b/bsd/dev/nabu_rpmh.c
@@ -0,0 +1,401 @@
+/*
+ * Apps RSC (DRV2) active votes for nabu (SM8150): port of ios-sweet 0062 + sd855_ios26 0085/0102/0120 sweet_rpmh.c.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int nabu_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_ARC          3u
+#define RH_BCM          5u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("NABU RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("NABU RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("NABU RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("NABU RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("NABU RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("NABU RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("NABU RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("NABU RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("NABU RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if ((slave != RH_VRM && slave != RH_ARC && slave != RH_BCM) || (addr >> 16) != slave || (addr & 3u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("NABU RPMH: invalid VRM/ARC/BCM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("NABU RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("NABU RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send_cmds(uint32_t address, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("NABU RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("NABU RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("NABU RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	uint32_t mask = (1u << n) - 1u;
+	printf("NABU RPMH: TCS%u ACTIVE %u commands at %#x (first %#x=%u) irq-enable=%#x\n", t, n, address,
+	    offsets[0], values[0], irq_en);
+	for (unsigned c = 0; c < n; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, mask) || !rh_sync(b + RH_ENABLE, mask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[4] = {0, 0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < n; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("NABU RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("NABU RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("NABU RPMH: ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	return rh_send_cmds(address, 3, offsets, values);
+}
+
+/*
+ * Any VRM, ARC or BCM resource, 1-4 commands (offset from the resource address,
+ * value): for /dev/pmem's PMEM_RPMH (userland bring-up of the modem and
+ * WLAN: ARC levels of cx/mss, WLAN rails). No policy: a debugging path.
+ */
+int nabu_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+int
+nabu_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	if (!res || n == 0 || n > 4) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, &address);
+		}
+		if (!error) {
+			error = rh_send_cmds(address, n, offsets, values);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+nabu_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	/* Redmi touch L11C; flame touch L14A (DVDD) and L17A (AVDD), DT ranges. */
+	bool ok = res && ((!strcmp(res, "ldoc11") && mv >= 2950 && mv <= 3400) ||
+	    (!strcmp(res, "ldoa14") && mv >= 1800 && mv <= 1840) ||
+	    (!strcmp(res, "ldoa17") && mv >= 2856 && mv <= 3008));
+	if (!ok) {
+		printf("NABU RPMH: %s %u mV is not an allowed touch rail\n", res ? res : "?", mv);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("NABU RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("NABU RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
